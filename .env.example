# Copie ce fichier en .env et renseigne les valeurs depuis le tableau
# de bord de ton projet Supabase (Project Settings → API).
#
# Ces variables sont préfixées EXPO_PUBLIC_ car elles doivent être
# incluses dans le bundle client (Expo les remplace au build). La clé
# "anon" est publique par design : c'est la RLS côté base de données qui
# protège les données, jamais le secret de cette clé.

EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
